{
  "folders": [
    {
      "name": "student-web",
      "path": "student-web"
    },
    {
      "name": "student-api",
      "path": "student-api"
    }
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Student API",
        "preLaunchTask": "Start Student API",
        "program": "${workspaceFolder:student-api}/server.js",
        "cwd": "${workspaceFolder:student-api}",
        "skipFiles": [
          "<node_internals>/**"
        ]
      },
      {
        "type": "chrome",
        "request": "launch",
        "name": "Debug Student Web",
        "preLaunchTask": "Start Student Web",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder:student-web}"
      }
    ],
    "compounds": [
      {
        "name": "Debug Web + API",
        "configurations": [
          "Debug Student API",
          "Debug Student Web"
        ]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start Student Web",
        "type": "npm",
        "script": "dev",
        "path": "student-web",
        "isBackground": true,
        "problemMatcher": {
          "owner": "custom",
          "pattern": {
            "regexp": "."
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Local:"
          }
        }
      },
      {
        "label": "Start Student API",
        "type": "shell",
        "command": "node server.js",
        "options": {
          "cwd": "${workspaceFolder:student-api}"
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "custom",
          "pattern": {
            "regexp": "."
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Server running on http://localhost:3000"
          }
        }
      }
    ]
  }
}
